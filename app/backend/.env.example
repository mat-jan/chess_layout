# ─── Skopiuj do .env i uzupełnij ────────────────────────────────────────────
DATABASE_URL=postgresql://chess:ZMIEN_HASLO@localhost:5432/chess_db
JWT_SECRET=wpisz-tutaj-dlugi-losowy-sekret-min-32-znaki

# Domeny dozwolone przez CORS, rozdzielone przecinkami. W produkcji NIE używaj "*".
CORS_ORIGINS=https://twojadomena.pl

# Backend odmawia startu z domyślnym publicznym JWT_SECRET. Ustaw na "1" tylko
# do lokalnych testów jeśli naprawdę nie chcesz ustawiać własnego sekretu.
# ALLOW_INSECURE_JWT_SECRET=1
